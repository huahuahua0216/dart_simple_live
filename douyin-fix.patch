diff --git a/simple_live_core/test/douyin_session_test.dart b/simple_live_core/test/douyin_session_test.dart
new file mode 100644
index 0000000..d7100f4
--- /dev/null
+++ b/simple_live_core/test/douyin_session_test.dart
@@ -0,0 +1,106 @@
+import 'dart:convert';
+
+import 'package:dio/dio.dart';
+import 'package:simple_live_core/simple_live_core.dart';
+import 'package:simple_live_core/src/common/douyin_category_parser.dart';
+import 'package:simple_live_core/src/common/http_client.dart';
+import 'package:test/test.dart';
+
+void main() {
+  test('categories are decoded without trailing React component data', () {
+    final category = {
+      'partition': {'id_str': '102', 'type': 4, 'title': 'Music "live"'},
+      'sub_partition': [],
+    };
+    final record = '2:${jsonEncode([
+      r'$',
+      'component',
+      null,
+      {
+        'children': [
+          {'pathname': '/', 'categoryData': [category]},
+          [r'$', 'another-component', null, {'children': r'$undefined'}],
+        ],
+      },
+    ])}\n';
+    final split = record.length ~/ 2;
+    for (final stream in ['pace', 'next']) {
+      final html = '<script>self.__${stream}_f.push(${jsonEncode([1, record.substring(0, split)])})</script>'
+          '<script>self.__${stream}_f.push(${jsonEncode([1, record.substring(split)])})</script>';
+      expect(parseDouyinCategories(html), [category]);
+    }
+    expect(() => parseDouyinCategories('<html>unavailable</html>'),
+        throwsFormatException);
+  });
+
+  late Dio originalClient;
+  late Dio client;
+  var requests = 0;
+
+  setUp(() {
+    originalClient = HttpClient.instance.dio;
+    client = Dio();
+    HttpClient.instance.dio = client;
+    requests = 0;
+    client.interceptors.add(InterceptorsWrapper(onRequest: (options, handler) {
+      requests++;
+      handler.resolve(Response(
+        requestOptions: options,
+        statusCode: 404,
+        headers: Headers.fromMap({
+          'set-cookie': [
+            'ttwid=fresh-visitor; Path=/; HttpOnly',
+            'UIFID=visitor-id; Path=/',
+          ],
+          'x-ms-token': ['visitor-token'],
+        }),
+      ));
+    }));
+  });
+
+  tearDown(() {
+    HttpClient.instance.dio = originalClient;
+    client.close(force: true);
+  });
+
+  test('concurrent requests share initialization and isolated headers', () async {
+    final site = DouyinSite();
+    final results = await Future.wait([
+      site.getRequestHeaders(),
+      site.getRequestHeaders(),
+    ]);
+    expect(requests, 1);
+    expect(results.first['cookie'], contains('ttwid=fresh-visitor'));
+    expect(results.first['cookie'], contains('msToken=visitor-token'));
+    expect(results.first['cookie'], isNot(contains('HttpOnly')));
+    results.first['Referer'] = 'https://live.douyin.com/12345';
+    expect(results.last['Referer'], DouyinSite.kDefaultReferer);
+    expect((await site.getRequestHeaders())['Referer'],
+        DouyinSite.kDefaultReferer);
+    expect(requests, 1);
+  });
+
+  test('custom cookie is preserved without requesting a visitor session', () async {
+    final site = DouyinSite()..cookie = 'ttwid=custom-visitor';
+    expect((await site.getRequestHeaders())['cookie'], 'ttwid=custom-visitor');
+    expect(requests, 0);
+  });
+
+  test('failed initialization can be retried', () async {
+    client.interceptors.clear();
+    client.interceptors.add(InterceptorsWrapper(onRequest: (options, handler) {
+      requests++;
+      handler.resolve(Response(
+        requestOptions: options,
+        statusCode: 200,
+        headers: Headers.fromMap({
+          if (requests > 1) 'set-cookie': ['ttwid=new-visitor; Path=/'],
+        }),
+      ));
+    }));
+    final site = DouyinSite();
+    await expectLater(site.getRequestHeaders(), throwsException);
+    expect((await site.getRequestHeaders())['cookie'], 'ttwid=new-visitor');
+    expect(requests, 2);
+  });
+}
diff --git a/simple_live_core/lib/src/common/douyin_category_parser.dart b/simple_live_core/lib/src/common/douyin_category_parser.dart
new file mode 100644
index 0000000..5cfe71d
--- /dev/null
+++ b/simple_live_core/lib/src/common/douyin_category_parser.dart
@@ -0,0 +1,47 @@
+import 'dart:convert';
+
+List<dynamic> parseDouyinCategories(String html) {
+  final chunks = StringBuffer();
+  final scripts = RegExp(
+    r'self\.__(?:pace|next)_f\.push\((.*?)\)</script>',
+    dotAll: true,
+  );
+  for (final match in scripts.allMatches(html)) {
+    try {
+      final chunk = jsonDecode(match.group(1)!);
+      if (chunk is List && chunk.length > 1 && chunk[1] is String) {
+        chunks.write(chunk[1]);
+      }
+    } on FormatException {
+      continue;
+    }
+  }
+  // Decode the streamed component records before looking for category props.
+  for (final line in const LineSplitter().convert(chunks.toString())) {
+    final separator = line.indexOf(':');
+    if (separator < 0) continue;
+    try {
+      final categories = _findCategories(jsonDecode(line.substring(separator + 1)));
+      if (categories != null && categories.isNotEmpty) return categories;
+    } on FormatException {
+      continue;
+    }
+  }
+  throw const FormatException('Douyin category data was not found');
+}
+
+List<dynamic>? _findCategories(dynamic value) {
+  if (value is Map) {
+    if (value['categoryData'] is List) return value['categoryData'] as List;
+    for (final child in value.values) {
+      final result = _findCategories(child);
+      if (result != null) return result;
+    }
+  } else if (value is List) {
+    for (final child in value) {
+      final result = _findCategories(child);
+      if (result != null) return result;
+    }
+  }
+  return null;
+}
