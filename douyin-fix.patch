diff --git a/simple_live_core/test/douyin_session_test.dart b/simple_live_core/test/douyin_session_test.dart
new file mode 100644
index 0000000..d6b4409
--- /dev/null
+++ b/simple_live_core/test/douyin_session_test.dart
@@ -0,0 +1,77 @@
+import 'package:dio/dio.dart';
+import 'package:simple_live_core/simple_live_core.dart';
+import 'package:simple_live_core/src/common/http_client.dart';
+import 'package:test/test.dart';
+
+void main() {
+  late Dio originalClient;
+  late Dio client;
+  var requests = 0;
+
+  setUp(() {
+    originalClient = HttpClient.instance.dio;
+    client = Dio();
+    HttpClient.instance.dio = client;
+    requests = 0;
+    client.interceptors.add(InterceptorsWrapper(onRequest: (options, handler) {
+      requests++;
+      handler.resolve(Response(
+        requestOptions: options,
+        statusCode: 404,
+        headers: Headers.fromMap({
+          'set-cookie': [
+            'ttwid=fresh-visitor; Path=/; HttpOnly',
+            'UIFID=visitor-id; Path=/',
+          ],
+          'x-ms-token': ['visitor-token'],
+        }),
+      ));
+    }));
+  });
+
+  tearDown(() {
+    HttpClient.instance.dio = originalClient;
+    client.close(force: true);
+  });
+
+  test('concurrent requests share initialization and isolated headers', () async {
+    final site = DouyinSite();
+    final results = await Future.wait([
+      site.getRequestHeaders(),
+      site.getRequestHeaders(),
+    ]);
+    expect(requests, 1);
+    expect(results.first['cookie'], contains('ttwid=fresh-visitor'));
+    expect(results.first['cookie'], contains('msToken=visitor-token'));
+    expect(results.first['cookie'], isNot(contains('HttpOnly')));
+    results.first['Referer'] = 'https://live.douyin.com/12345';
+    expect(results.last['Referer'], DouyinSite.kDefaultReferer);
+    expect((await site.getRequestHeaders())['Referer'],
+        DouyinSite.kDefaultReferer);
+    expect(requests, 1);
+  });
+
+  test('custom cookie is preserved without requesting a visitor session', () async {
+    final site = DouyinSite()..cookie = 'ttwid=custom-visitor';
+    expect((await site.getRequestHeaders())['cookie'], 'ttwid=custom-visitor');
+    expect(requests, 0);
+  });
+
+  test('failed initialization can be retried', () async {
+    client.interceptors.clear();
+    client.interceptors.add(InterceptorsWrapper(onRequest: (options, handler) {
+      requests++;
+      handler.resolve(Response(
+        requestOptions: options,
+        statusCode: 200,
+        headers: Headers.fromMap({
+          if (requests > 1) 'set-cookie': ['ttwid=new-visitor; Path=/'],
+        }),
+      ));
+    }));
+    final site = DouyinSite();
+    await expectLater(site.getRequestHeaders(), throwsException);
+    expect((await site.getRequestHeaders())['cookie'], 'ttwid=new-visitor');
+    expect(requests, 2);
+  });
+}
