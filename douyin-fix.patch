diff --git a/simple_live_app/lib/modules/search/douyin/douyin_search_results.dart b/simple_live_app/lib/modules/search/douyin/douyin_search_results.dart
new file mode 100644
index 0000000..b8441af
--- /dev/null
+++ b/simple_live_app/lib/modules/search/douyin/douyin_search_results.dart
@@ -0,0 +1,81 @@
+import 'dart:convert';
+
+import 'package:simple_live_core/simple_live_core.dart';
+
+class DouyinSearchResults {
+  final List<LiveRoomItem> items;
+  final bool hasMore;
+  DouyinSearchResults(this.items, this.hasMore);
+
+  static DouyinSearchResults parse(Map data) {
+    if (data['status_code'] == 2483 ||
+        data['search_nil_info']?['search_nil_type'] == 'verify_check') {
+      throw const FormatException('抖音需要登录或验证，请完成验证后重试');
+    }
+    if (data['status_code'] != 0 || data['data'] is! List) {
+      throw const FormatException('抖音搜索返回格式异常');
+    }
+    final items = <LiveRoomItem>[];
+    final ids = <String>{};
+    for (final entry in data['data']) {
+      try {
+        final raw = entry['lives']['rawdata'];
+        final room = raw is String ? jsonDecode(raw) : raw;
+        final owner = room['owner'];
+        final id = owner['web_rid']?.toString() ?? '';
+        if (!RegExp(r'^\d{1,16}$').hasMatch(id) || !ids.add(id)) continue;
+        final covers = room['cover']?['url_list'];
+        items.add(LiveRoomItem(
+          roomId: id,
+          title: room['title']?.toString() ?? '',
+          cover: covers is List && covers.isNotEmpty ? covers.first.toString() : '',
+          userName: owner['nickname']?.toString() ?? '',
+          online: int.tryParse((room['stats']?['total_user'] ??
+              room['room_view_stats']?['display_value'] ?? 0).toString()) ?? 0,
+        ));
+      } catch (_) {
+        // Mixed search payloads can include advertisements instead of rooms.
+      }
+    }
+    if ((data['data'] as List).isNotEmpty && items.isEmpty) {
+      throw const FormatException('抖音搜索结果格式已变化');
+    }
+    return DouyinSearchResults(items, data['has_more'] == 1 || data['has_more'] == true);
+  }
+}
+
+const douyinSearchCaptureScript = r'''
+(() => {
+  const send = (url, data) => {
+    try {
+      const u = new URL(url, location.href);
+      if (u.origin !== 'https://www.douyin.com' ||
+          u.pathname !== '/aweme/v1/web/live/search/') return;
+      const payload = {url: u.href, data, generation: new URL(location.href).searchParams.get('simple_live_generation')};
+      const deliver = () => window.flutter_inappwebview.callHandler('douyinSearchResults', payload);
+      if (window.flutter_inappwebview && window.flutter_inappwebview.callHandler) deliver();
+      else window.addEventListener('flutterInAppWebViewPlatformReady', deliver, {once: true});
+    } catch (_) {}
+  };
+  const open = XMLHttpRequest.prototype.open;
+  XMLHttpRequest.prototype.open = function(method, url, ...args) {
+    this.addEventListener('load', () => {
+      try { send(url, this.responseType === 'json' ? this.response : JSON.parse(this.responseText)); } catch (_) {}
+    }, {once: true});
+    return open.call(this, method, url, ...args);
+  };
+  const fetch = window.fetch;
+  window.fetch = async function(...args) {
+    const response = await fetch.apply(this, args);
+    const url = response.url || (typeof args[0] === 'string' ? args[0] : args[0].url);
+    if (url.includes('/aweme/v1/web/live/search/')) {
+      response.clone().json().then(data => send(url, data)).catch(() => {});
+    }
+    return response;
+  };
+  setInterval(() => document.querySelectorAll('video,audio').forEach(media => {
+    media.muted = true;
+    media.pause();
+  }), 1000);
+})();
+''';
